package pages

import (
	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

// ItemDetailData is the view model for the /items/:id page
type ItemDetailData struct {
	ID          int32
	Name        string
	Description string
	Rarity      string
	Cost        int32
}

templ Items() {
	@layouts.Base("Items", "/items") {
		<div class="space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<h1 class="text-2xl font-western text-wood">Item Editor</h1>
			</div>

			<!-- Search Card -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">Search Items</h2>
				</div>
				<div class="p-4">
					<div class="max-w-md">
						<label for="item-search" class="block text-sm font-medium text-wood mb-2">Item Name</label>
						<input
							type="text"
							id="item-search"
							name="q"
							placeholder="Type to search items..."
							class="w-full px-4 py-2 border border-dust rounded-lg bg-parchment text-wood placeholder-dust focus:outline-none focus:ring-2 focus:ring-leather focus:border-transparent"
							hx-get="/items/search"
							hx-trigger="input changed delay:300ms, search"
							hx-target="#search-results"
							hx-indicator="#search-spinner"
						/>
						<p class="mt-1 text-sm text-dust">Blank search lists all items</p>
					</div>
				</div>
			</div>

			<!-- Search Results -->
			<div class="card">
				<div class="p-4 border-b border-dust/30 flex items-center justify-between">
					<h2 class="font-semibold text-wood">Results</h2>
					<div id="search-spinner" class="htmx-indicator">
						<div class="spinner"></div>
					</div>
				</div>
				<div id="search-results" class="p-4" hx-get="/items/search" hx-trigger="load" hx-swap="innerHTML">
					<p class="text-dust text-center py-8">Loading items...</p>
				</div>
			</div>

			<!-- Create Item -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">Create Item</h2>
				</div>
				<form class="p-4 space-y-4" action="/items" method="POST">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label for="name" class="block text-sm font-medium text-wood mb-1">Name</label>
							<input type="text" id="name" name="name" class="input" required/>
						</div>
						<div>
							<label for="rarity" class="block text-sm font-medium text-wood mb-1">Rarity</label>
							<select id="rarity" name="rarity" class="input">
								@RarityOptions("COMMON")
							</select>
						</div>
					</div>
					<div>
						<label for="description" class="block text-sm font-medium text-wood mb-1">Description</label>
						<textarea id="description" name="description" rows="3" class="input" required></textarea>
					</div>
					<div class="max-w-xs">
						<label for="cost" class="block text-sm font-medium text-wood mb-1">Cost (coins)</label>
						<input type="number" id="cost" name="cost" min="0" value="0" class="input" required/>
					</div>
					<div class="flex justify-end">
						<button type="submit" class="btn-primary">CREATE ITEM</button>
					</div>
				</form>
			</div>
		</div>
	}
}

// RarityOptions renders the rarity <option> list with the given value selected.
templ RarityOptions(selected string) {
	<option value="COMMON" selected?={ selected == "COMMON" }>COMMON</option>
	<option value="UNCOMMON" selected?={ selected == "UNCOMMON" }>UNCOMMON</option>
	<option value="RARE" selected?={ selected == "RARE" }>RARE</option>
	<option value="EPIC" selected?={ selected == "EPIC" }>EPIC</option>
	<option value="LEGENDARY" selected?={ selected == "LEGENDARY" }>LEGENDARY</option>
	<option value="MYTHICAL" selected?={ selected == "MYTHICAL" }>MYTHICAL</option>
	<option value="ROLE_SPECIFIC" selected?={ selected == "ROLE_SPECIFIC" }>ROLE_SPECIFIC</option>
	<option value="UNIQUE" selected?={ selected == "UNIQUE" }>UNIQUE</option>
}
