package pages

import (
	"strconv"
	"github.com/mccune1224/betrayal/internal/models"
	"github.com/mccune1224/betrayal/internal/services/roledraft"
	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

type SetupData struct { DiscordConnected bool; DeceptionistDefault int }
type SetupResultData struct { Pool *roledraft.Pool; PlayerCount int; DeceptionistCount int }

templ SetupPage(data SetupData) {
	@layouts.Base("Game Setup", "/setup") {
		<h1 class="page-title mb-2">GAME SETUP</h1>
		<p class="text-dust text-sm mb-6">Generate the role lineup once before a game. This does not assign roles or modify players.</p>
		<div class="card mb-6">
			<form hx-post="/setup/generate" hx-target="#setup-result" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
				<input class="input" type="number" min="0" name="player_count" placeholder="Player count" required/>
				<input class="input" type="number" min="0" name="deceptionist_count" value={ strconv.Itoa(data.DeceptionistDefault) } placeholder="Deceptionist count" required/>
				<button class="btn-primary">GENERATE ROLE POOL</button>
			</form>
			if data.DiscordConnected {
				<p class="text-xs text-dust mt-2">Deceptionist count defaults to members with the Discord Deceptionist role.</p>
			}
		</div>
		<div id="setup-result"></div>
	}
}

templ SetupResult(data SetupResultData) {
	<div class="space-y-6" id="setup-result">
		<div class="card">
			<div class="flex justify-between"><h2 class="font-semibold text-wood">ROLE POOL ({ strconv.Itoa(len(data.Pool.RandomPool)) })</h2><button class="btn-ghost" type="button" onclick="navigator.clipboard.writeText(document.getElementById('role-pool-text').innerText)">COPY AS TEXT</button></div>
			<pre id="role-pool-text" class="text-sm text-dust whitespace-pre-wrap mt-3">{ poolText(data.Pool) }</pre>
		</div>
		if len(data.Pool.DeceptionOptions) > 0 {
			<div class="card"><h2 class="font-semibold text-wood mb-3">DECEPTIONIST RESERVED OPTIONS</h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
					for i, option := range data.Pool.DeceptionOptions {
						<div class="mobile-card"><p class="text-xs text-dust">DECEPTIONIST { strconv.Itoa(i+1) }</p>{ roleNames(option) }</div>
					}
				</div>
			</div>
		}
	</div>
}

func roleNames(roles []models.Role) string { out := ""; for _, r := range roles { out += r.Name + "\n" }; return out }
func poolText(p *roledraft.Pool) string { out := "Random pool:\n"; for _, r := range p.RandomPool { out += r.Name + "\n" }; return out }
