package pages

import (
	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

// AbilityDetailData is the view model for the /abilities/:id page
type AbilityDetailData struct {
	ID             int32
	Name           string
	Description    string
	DefaultCharges int32
	AnyAbility     bool
	Rarity         string
}

templ Abilities() {
	@layouts.Base("Abilities", "/abilities") {
		<div class="space-y-6">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<h1 class="text-2xl font-western text-wood">Ability Editor</h1>
			</div>

			<!-- Search Card -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">Search Abilities</h2>
				</div>
				<div class="p-4">
					<div class="max-w-md">
						<label for="ability-search" class="block text-sm font-medium text-wood mb-2">Ability Name</label>
						<input
							type="text"
							id="ability-search"
							name="q"
							placeholder="Type to search abilities..."
							class="w-full px-4 py-2 border border-dust rounded-lg bg-parchment text-wood placeholder-dust focus:outline-none focus:ring-2 focus:ring-leather focus:border-transparent"
							hx-get="/abilities/search"
							hx-trigger="input changed delay:300ms, search"
							hx-target="#search-results"
							hx-indicator="#search-spinner"
						/>
						<p class="mt-1 text-sm text-dust">Blank search lists all abilities</p>
					</div>
				</div>
			</div>

			<!-- Search Results -->
			<div class="card">
				<div class="p-4 border-b border-dust/30 flex items-center justify-between">
					<h2 class="font-semibold text-wood">Results</h2>
					<div id="search-spinner" class="htmx-indicator">
						<div class="spinner"></div>
					</div>
				</div>
				<div id="search-results" class="p-4" hx-get="/abilities/search" hx-trigger="load" hx-swap="innerHTML">
					<p class="text-dust text-center py-8">Loading abilities...</p>
				</div>
			</div>

			<!-- Create Ability -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">Create Ability</h2>
				</div>
				<form class="p-4 space-y-4" action="/abilities" method="POST">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label for="name" class="block text-sm font-medium text-wood mb-1">Name</label>
							<input type="text" id="name" name="name" class="input" required/>
						</div>
						<div>
							<label for="rarity" class="block text-sm font-medium text-wood mb-1">Rarity</label>
							<select id="rarity" name="rarity" class="input">
								@RarityOptions("COMMON")
							</select>
						</div>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label for="default_charges" class="block text-sm font-medium text-wood mb-1">Default Charges</label>
							<input type="number" id="default_charges" name="default_charges" min="0" value="0" class="input" required/>
						</div>
						<div class="flex items-end pb-2">
							<label class="flex items-center gap-2 text-sm font-medium text-wood">
								<input type="checkbox" name="any_ability" class="w-4 h-4 accent-wood"/>
								Any Ability (AA)
							</label>
						</div>
					</div>
					<div>
						<label for="description" class="block text-sm font-medium text-wood mb-1">Description</label>
						<textarea id="description" name="description" rows="3" class="input" required></textarea>
					</div>
					<div class="flex justify-end">
						<button type="submit" class="btn-primary">CREATE ABILITY</button>
					</div>
				</form>
			</div>
		</div>
	}
}
