package pages

import (
	"fmt"
	"strconv"

	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

// CycleData is the view model for the /cycle page
type CycleData struct {
	Phase string // "Day" or "Elimination"
	Day   int
}

// String renders "Day 3" / "Elimination 3"
func (d CycleData) String() string {
	return fmt.Sprintf("%s %d", d.Phase, d.Day)
}

templ Cycle(data CycleData) {
	@layouts.Base("Game Cycle", "/cycle") {
		<h1 class="page-title mb-6">GAME CYCLE</h1>

		<div class="mb-6">
			<a href="/" class="text-leather hover:text-leather-dark transition-colors">
				&larr; Back to Dashboard
			</a>
		</div>

		<!-- Live cycle status card (HTMX swaps this on advance/set) -->
		<div id="cycle-status" hx-swap="outerHTML">
			@CycleStatusCard(data)
		</div>

		<!-- How cycle transitions work -->
		<div class="card mt-6">
			<div class="p-4 border-b border-dust/30">
				<h2 class="font-semibold text-wood">How Phases Work</h2>
			</div>
			<div class="p-4 space-y-2 text-sm text-dust">
				<p>&#x2022; Day <span class="text-wood font-semibold">n</span> &rarr; Elimination <span class="text-wood font-semibold">n</span> &rarr; Day <span class="text-wood font-semibold">n+1</span></p>
				<p>&#x2022; Day 0 (game start) advances straight to Day 1.</p>
				<p>&#x2022; <span class="text-rust font-semibold">Note:</span> changes made here update the database only — they do <span class="font-semibold">not</span> broadcast cycle messages to Discord channels (use /cycle in Discord for that).</p>
			</div>
		</div>
	}
}

// CycleStatusCard is the current-phase card, used by the page and returned by
// the /cycle/advance and /cycle/set HTMX endpoints.
templ CycleStatusCard(data CycleData) {
	<div class="card">
		<div class="p-4 border-b border-dust/30">
			<h2 class="font-semibold text-wood">CURRENT PHASE</h2>
		</div>
		<div class="p-4 space-y-6">
			<div class="flex items-center justify-center gap-4 py-4">
				<span class="text-4xl md:text-5xl font-western text-leather">{ data.Phase }</span>
				<span class={ "text-4xl md:text-5xl font-western", templ.KV("text-rust", data.Phase == "Elimination"), templ.KV("text-sage", data.Phase == "Day") }>
					{ strconv.Itoa(data.Day) }
				</span>
			</div>

			<!-- Advance -->
			<div class="flex justify-center">
				<button
					class="btn-primary w-full md:w-auto font-western tracking-wide text-lg px-8"
					hx-post="/cycle/advance"
					hx-target="#cycle-status"
					hx-swap="outerHTML"
				>
					ADVANCE TO NEXT PHASE
				</button>
			</div>

			<!-- Set -->
			<div class="border-t border-dust/30 pt-6">
				<p class="text-sm text-dust mb-3 text-center">Hard-set the phase</p>
				<form
					class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
					hx-post="/cycle/set"
					hx-target="#cycle-status"
					hx-swap="outerHTML"
				>
					<select
						name="phase"
						class="input flex-1"
						aria-label="Phase"
					>
						<option value="Day" selected?={ data.Phase == "Day" }>Day</option>
						<option value="Elimination" selected?={ data.Phase == "Elimination" }>Elimination</option>
					</select>
					<input
						type="number"
						name="number"
						min="0"
						value={ strconv.Itoa(data.Day) }
						class="input w-full sm:w-28"
						aria-label="Day number"
						required
					/>
					<button type="submit" class="btn-ghost">SET</button>
				</form>
			</div>
		</div>
	</div>
}
