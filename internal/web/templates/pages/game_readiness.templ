package pages

import (
	"strconv"

	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

type GameReadinessData struct {
	Ready            bool
	DiscordConnected bool
	AdminChannels    int
	AdminReady       bool
	VoteChannel      string
	VoteReady        bool
	ActionChannel    string
	ActionReady      bool
	LifeboardReady   bool
	PlayerCount      int
	Alive            int
	Dead             int
	CycleReady       bool
	CyclePhase       string
	CycleDay         int
}

templ GameReadiness(data GameReadinessData) {
	@layouts.Base("Game Readiness", "/healthcheck") {
		<h1 class="page-title mb-2">GAME READINESS</h1>
		<p class="text-dust text-sm mb-6">A quick pre-game check for hosts. Green means the panel found what it needs; warnings are safe to fix before players arrive.</p>

		<div class={ "card mb-6 border-2", templ.KV("border-sage", data.Ready), templ.KV("border-rust", !data.Ready) }>
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
				<div>
					<h2 class="font-semibold text-wood">{ readinessTitle(data.Ready) }</h2>
					<p class="text-sm text-dust mt-1">{ readinessSummary(data) }</p>
				</div>
				<a class="btn-primary text-center" href="/setup">OPEN SETUP</a>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			@ReadinessCheck("Admin channels", data.AdminReady, strconv.Itoa(data.AdminChannels)+" configured")
			@ReadinessCheck("Vote channel", data.VoteReady, channelDescription(data.VoteChannel))
			@ReadinessCheck("Action channel", data.ActionReady, channelDescription(data.ActionChannel))
			@ReadinessCheck("Players", data.PlayerCount > 0, playerDescription(data))
			@ReadinessCheck("Current game cycle", data.CycleReady, cycleDescription(data))
			@ReadinessCheck("Lifeboard", data.LifeboardReady, optionalDescription(data.LifeboardReady))
			@ReadinessCheck("Discord connection", data.DiscordConnected, discordDescription(data.DiscordConnected))
		</div>

		<div class="card mt-6">
			<h2 class="font-semibold text-wood mb-3">WHAT TO DO NEXT</h2>
			<ul class="list-disc pl-5 space-y-2 text-sm text-dust">
				<li>Use <a class="table-link" href="/channels">Channels</a> to configure missing funnels and the lifeboard.</li>
				<li>Use <a class="table-link" href="/players/new">Players</a> to add the roster and assign roles.</li>
				<li>Use <a class="table-link" href="/sync">Sync</a> only when you need to refresh the catalog from the data-entry sheets.</li>
			</ul>
		</div>
	}
}

func readinessTitle(ready bool) string {
	if ready { return "READY TO SET UP THE GAME" }
	return "A FEW THINGS STILL NEED ATTENTION"
}

func readinessSummary(data GameReadinessData) string {
	if data.Ready { return "Required channels and at least one player are configured." }
	return "Fix the red checks below before starting the game."
}

func channelDescription(channel string) string {
	if channel == "" { return "Not configured" }
	return "Configured: " + channel
}

func playerDescription(data GameReadinessData) string {
	return strconv.Itoa(data.PlayerCount) + " players (" + strconv.Itoa(data.Alive) + " alive, " + strconv.Itoa(data.Dead) + " dead)"
}

func cycleDescription(data GameReadinessData) string {
	if !data.CycleReady { return "No cycle has been started" }
	return data.CyclePhase + " " + strconv.Itoa(data.CycleDay)
}

func optionalDescription(configured bool) string {
	if configured { return "Configured" }
	return "Optional — not configured"
}

func discordDescription(connected bool) string {
	if connected { return "Connected; channel IDs can be verified" }
	return "Web-only mode; IDs cannot be verified"
}

templ ReadinessCheck(label string, ready bool, detail string) {
	<div class="card">
		<div class="flex items-start gap-3">
			<span class={ "text-2xl", templ.KV("text-sage", ready), templ.KV("text-rust", !ready) }>{ checkMark(ready) }</span>
			<div><h2 class="font-semibold text-wood">{ label }</h2><p class="text-sm text-dust mt-1">{ detail }</p></div>
		</div>
	</div>
}

func checkMark(ready bool) string {
	if ready { return "✓" }
	return "!"
}
