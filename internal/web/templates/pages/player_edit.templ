package pages

import (
	"strconv"

	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
	"github.com/mccune1224/betrayal/internal/web/templates/partials"
)

// Row types for the player edit inventory sections
type PlayerEditItemRow struct {
	ID       int32
	Name     string
	Quantity int32
}

type PlayerEditAbilityRow struct {
	ID       int32
	Name     string
	Quantity int32
}

type PlayerEditStatusRow struct {
	ID       int32
	Name     string
	Quantity int32
}

type PlayerEditPerkRow struct {
	ID   int32
	Name string
}

// PlayerEditData is the view model for the /players/:id/edit page
type PlayerEditData struct {
	ID        int64
	Role      string
	Alive     bool
	Coins     int
	Luck      int
	Items     []PlayerEditItemRow
	Abilities []PlayerEditAbilityRow
	Statuses  []PlayerEditStatusRow
	Perks     []PlayerEditPerkRow
}

templ PlayerEdit(data PlayerEditData) {
	@layouts.Base("Edit Player", "/players") {
		<!-- Back Link -->
		<a href={ "/players/" + strconv.FormatInt(data.ID, 10) } class="table-link text-sm mb-4 inline-flex">
			&#x2190; BACK TO PLAYER
		</a>

		<!-- Header -->
		<div class="card mb-4">
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
				<div>
					<h1 class="text-xl font-western text-leather tracking-wide">{ data.Role }</h1>
					<p class="text-xs text-dust mt-1">ID: { strconv.FormatInt(data.ID, 10) }</p>
				</div>
				<div class="flex items-center gap-2">
					@partials.StatusBadge(data.Alive)
					<span class="badge-neutral">EDIT</span>
				</div>
			</div>
		</div>

		<div class="space-y-6">
			<!-- Coins & Luck -->
			<div id="edit-stats">
				@PlayerEditStats(data.ID, data.Coins, data.Luck)
			</div>

			<!-- Items -->
			<div id="edit-items">
				@PlayerEditItems(data.ID, data.Items)
			</div>

			<!-- Abilities -->
			<div id="edit-abilities">
				@PlayerEditAbilities(data.ID, data.Abilities)
			</div>

			<!-- Statuses -->
			<div id="edit-statuses">
				@PlayerEditStatuses(data.ID, data.Statuses)
			</div>

			<!-- Perks -->
			<div id="edit-perks">
				@PlayerEditPerks(data.ID, data.Perks)
			</div>
		</div>
	}
}

// PlayerEditStats is the coins/luck form card
templ PlayerEditStats(playerID int64, coins int, luck int) {
	<div class="card">
		<div class="p-4 border-b border-dust/30">
			<h2 class="font-semibold text-wood">STATS</h2>
		</div>
		<form
			class="p-4"
			hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/edit" }
			hx-target="#edit-stats"
			hx-swap="outerHTML"
		>
			<div class="grid grid-cols-2 gap-4 max-w-md">
				<div>
					<label for="coins" class="block text-sm font-medium text-wood mb-1">COINS</label>
					<input type="number" id="coins" name="coins" min="0" value={ strconv.Itoa(coins) } class="input" required/>
				</div>
				<div>
					<label for="luck" class="block text-sm font-medium text-wood mb-1">LUCK</label>
					<input type="number" id="luck" name="luck" min="0" value={ strconv.Itoa(luck) } class="input" required/>
				</div>
			</div>
			<div class="flex justify-end mt-4">
				<button type="submit" class="btn-primary">SAVE STATS</button>
			</div>
		</form>
	</div>
}

// PlayerEditItems is the item inventory section (list + add form)
templ PlayerEditItems(playerID int64, items []PlayerEditItemRow) {
	@PlayerEditSection("ITEMS", len(items), PlayerEditItemAddForm(playerID)) {
		for _, it := range items {
			<div class="flex items-center justify-between gap-3 px-3 py-2 bg-parchment-dark rounded-lg">
				<div class="min-w-0">
					<p class="text-sm text-wood font-semibold truncate">{ it.Name }</p>
					<p class="text-xs text-dust">x{ strconv.Itoa(int(it.Quantity)) }</p>
				</div>
				<form
					hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/items/remove" }
					hx-target="#edit-items"
					hx-swap="outerHTML"
					class="shrink-0"
				>
					<input type="hidden" name="item_name" value={ it.Name }/>
					<button type="submit" class="btn-danger btn-sm">REMOVE</button>
				</form>
			</div>
		}
	}
}

templ PlayerEditItemAddForm(playerID int64) {
	<form
		class="flex flex-col sm:flex-row gap-2"
		hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/items/add" }
		hx-target="#edit-items"
		hx-swap="outerHTML"
	>
		<input type="text" name="item_name" placeholder="Item name" class="input flex-1" required/>
		<input type="number" name="quantity" min="1" value="1" class="input w-full sm:w-24" aria-label="Quantity"/>
		<button type="submit" class="btn-ghost shrink-0">ADD ITEM</button>
	</form>
}

// PlayerEditAbilities is the ability inventory section
templ PlayerEditAbilities(playerID int64, abilities []PlayerEditAbilityRow) {
	@PlayerEditSection("ABILITIES", len(abilities), PlayerEditAbilityAddForm(playerID)) {
		for _, ab := range abilities {
			<div class="flex items-center justify-between gap-3 px-3 py-2 bg-parchment-dark rounded-lg">
				<div class="min-w-0">
					<p class="text-sm text-wood font-semibold truncate">{ ab.Name }</p>
					<p class="text-xs text-dust">{ strconv.Itoa(int(ab.Quantity)) } charge(s)</p>
				</div>
				<form
					hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/abilities/remove" }
					hx-target="#edit-abilities"
					hx-swap="outerHTML"
					class="shrink-0"
				>
					<input type="hidden" name="ability_name" value={ ab.Name }/>
					<button type="submit" class="btn-danger btn-sm">REMOVE</button>
				</form>
			</div>
		}
	}
}

templ PlayerEditAbilityAddForm(playerID int64) {
	<form
		class="flex flex-col sm:flex-row gap-2"
		hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/abilities/add" }
		hx-target="#edit-abilities"
		hx-swap="outerHTML"
	>
		<input type="text" name="ability_name" placeholder="Ability name" class="input flex-1" required/>
		<input type="number" name="quantity" min="0" placeholder="Charges (blank = default)" class="input w-full sm:w-40" aria-label="Charges"/>
		<button type="submit" class="btn-ghost shrink-0">ADD</button>
	</form>
}

// PlayerEditStatuses is the status inventory section
templ PlayerEditStatuses(playerID int64, statuses []PlayerEditStatusRow) {
	@PlayerEditSection("STATUSES", len(statuses), PlayerEditStatusAddForm(playerID)) {
		for _, st := range statuses {
			<div class="flex items-center justify-between gap-3 px-3 py-2 bg-parchment-dark rounded-lg">
				<div class="min-w-0">
					<p class="text-sm text-wood font-semibold truncate">{ st.Name }</p>
					<p class="text-xs text-dust">x{ strconv.Itoa(int(st.Quantity)) }</p>
				</div>
				<form
					hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/statuses/remove" }
					hx-target="#edit-statuses"
					hx-swap="outerHTML"
					class="shrink-0"
				>
					<input type="hidden" name="status_name" value={ st.Name }/>
					<button type="submit" class="btn-danger btn-sm">REMOVE</button>
				</form>
			</div>
		}
	}
}

templ PlayerEditStatusAddForm(playerID int64) {
	<form
		class="flex flex-col sm:flex-row gap-2"
		hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/statuses/add" }
		hx-target="#edit-statuses"
		hx-swap="outerHTML"
	>
		<input type="text" name="status_name" placeholder="Status name" class="input flex-1" required/>
		<input type="number" name="quantity" min="1" value="1" class="input w-full sm:w-24" aria-label="Quantity"/>
		<button type="submit" class="btn-ghost shrink-0">ADD</button>
	</form>
}

// PlayerEditPerks is the perk inventory section
templ PlayerEditPerks(playerID int64, perks []PlayerEditPerkRow) {
	@PlayerEditSection("PERKS", len(perks), PlayerEditPerkAddForm(playerID)) {
		for _, pk := range perks {
			<div class="flex items-center justify-between gap-3 px-3 py-2 bg-parchment-dark rounded-lg">
				<p class="text-sm text-wood font-semibold truncate">{ pk.Name }</p>
				<form
					hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/perks/remove" }
					hx-target="#edit-perks"
					hx-swap="outerHTML"
					class="shrink-0"
				>
					<input type="hidden" name="perk_name" value={ pk.Name }/>
					<button type="submit" class="btn-danger btn-sm">REMOVE</button>
				</form>
			</div>
		}
	}
}

templ PlayerEditPerkAddForm(playerID int64) {
	<form
		class="flex flex-col sm:flex-row gap-2"
		hx-post={ "/players/" + strconv.FormatInt(playerID, 10) + "/perks/add" }
		hx-target="#edit-perks"
		hx-swap="outerHTML"
	>
		<input type="text" name="perk_name" placeholder="Perk name" class="input flex-1" required/>
		<button type="submit" class="btn-ghost shrink-0">ADD</button>
	</form>
}

// PlayerEditSection is the shared card shell for inventory sections.
// addForm is rendered in the card footer; children is the row list.
templ PlayerEditSection(title string, count int, addForm templ.Component) {
	<div class="card">
		<div class="p-4 border-b border-dust/30 flex items-center justify-between">
			<h2 class="font-semibold text-wood">{ title } ({ strconv.Itoa(count) })</h2>
		</div>
		<div class="p-4 space-y-2">
			{ children... }
			if count == 0 {
				<p class="text-dust text-sm text-center py-2">NONE</p>
			}
		</div>
		<div class="p-4 border-t border-dust/30">
			@addForm
		</div>
	</div>
}
