package pages

import (
	"fmt"

	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
)

// MigrationView is one schema migration for the UI.
type MigrationView struct {
	Version uint
	Name    string
	Applied bool
	Dirty   bool
	Last    bool // highest embedded version (current target)
}

// MigrationsPageData is the view model for /admin/migrations.
type MigrationsPageData struct {
	Migrations      []MigrationView
	HasPending      bool
	LastAppliedName string // name the user must type to confirm a rollback
	IsProd          bool
	AllowMutations  bool
	Unavailable     bool   // runner could not be built (no DSN configured)
	Error           string // status query failure
}

// MigrationsPage renders the full /admin/migrations page.
templ MigrationsPage(data MigrationsPageData) {
	@layouts.Base("Database Migrations", "/admin/migrations") {
		<h1 class="page-title mb-6">DATABASE MIGRATIONS</h1>
		@MigrationsContent(data)
	}
}

// MigrationsContent is the swappable page body (mutations return this and
// replace #migrations-page).
templ MigrationsContent(data MigrationsPageData) {
	<div id="migrations-page" class="space-y-6">
		if data.Unavailable {
			<div class="card">
				<div class="p-6 text-sm text-dust">
					Migrations UI unavailable: no database DSN was configured for the web server
					(<code class="text-wood">DATABASE_URL</code> / <code class="text-wood">DATABASE_POOLER_URL</code>).
					Use the Makefile targets instead.
				</div>
			</div>
		} else {
			if data.IsProd {
				<div class="card border-l-4 border-rust">
					<div class="p-4 text-sm text-rust">
						&#9888; Connected to the <span class="font-semibold">PRODUCTION</span> database.
						if !data.AllowMutations {
							Apply/rollback are <span class="font-semibold">blocked</span> — set <code class="text-wood">WEB_ALLOW_PROD_MUTATIONS=true</code> to enable them here.
						} else {
							Apply/rollback are enabled via <code class="text-wood">WEB_ALLOW_PROD_MUTATIONS=true</code>.
						}
					</div>
				</div>
			}

			if data.Error != "" {
				<div class="card">
					<div class="p-4 text-sm text-rust">&#9888; { data.Error }</div>
				</div>
			}

			<!-- Controls -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">CONTROLS</h2>
				</div>
				<div class="p-4 space-y-4">
					<div class="flex flex-col md:flex-row md:items-center gap-3">
						<div class="flex-1 text-sm text-dust">
							Apply all pending migrations (currently
							<span class={ pendingClass(data.HasPending) }>
								{ pendingText(data.HasPending) }
							</span>).
						</div>
						<button
							class="btn-primary font-western tracking-wide shrink-0"
							hx-post="/admin/migrations/up"
							hx-target="#migrations-page"
							hx-swap="outerHTML"
							disabled?={ !data.HasPending || (data.IsProd && !data.AllowMutations) }
						>
							APPLY PENDING
						</button>
					</div>

					<form
						class="flex flex-col md:flex-row md:items-end gap-3 border-t border-dust/20 pt-4"
						hx-post="/admin/migrations/down"
						hx-target="#migrations-page"
						hx-swap="outerHTML"
					>
						<div class="flex-1 space-y-1 text-sm text-dust">
							<label for="mig-steps" class="text-xs uppercase tracking-wide">Roll back</label>
							<input
								id="mig-steps"
								type="number"
								name="steps"
								min="1"
								max="10"
								value="1"
								class="input w-full md:w-24"
								aria-label="Number of migrations to roll back"
							/>
						</div>
						<div class="flex-1 space-y-1 text-sm text-dust">
							<label for="mig-confirm" class="text-xs uppercase tracking-wide">
								Type <code class="text-wood">{ data.LastAppliedName }</code> to confirm
							</label>
							<input
								id="mig-confirm"
								type="text"
								name="confirm"
								class="input w-full"
								placeholder={ data.LastAppliedName }
								autocomplete="off"
								required
							/>
						</div>
						<button
							type="submit"
							class="btn-ghost shrink-0"
							disabled?={ data.LastAppliedName == "" || (data.IsProd && !data.AllowMutations) }
						>
							ROLL BACK
						</button>
					</form>
				</div>
			</div>

			<!-- Migration table -->
			<div class="card">
				<div class="p-4 border-b border-dust/30">
					<h2 class="font-semibold text-wood">MIGRATIONS</h2>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-sm">
						<thead>
							<tr class="text-left text-xs uppercase tracking-wide text-dust border-b border-dust/20">
								<th class="p-3">Version</th>
								<th class="p-3">Name</th>
								<th class="p-3">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-dust/10">
							for _, m := range data.Migrations {
								<tr class={ migrationRowClass(m) }>
									<td class="p-3 font-mono text-wood">{ fmt.Sprintf("%06d", m.Version) }</td>
									<td class="p-3 text-dust">{ m.Name }</td>
									<td class="p-3">
										if m.Applied {
											if m.Dirty {
												<span class="badge badge-evil">dirty</span>
											} else {
												<span class="badge badge-good">applied</span>
											}
										} else {
											<span class="badge">pending</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
}

// --- helpers ---

func migrationRowClass(m MigrationView) string {
	if m.Last {
		return "bg-amber-500/5"
	}
	return ""
}

func pendingText(hasPending bool) string {
	if hasPending {
		return "pending"
	}
	return "up to date"
}

func pendingClass(hasPending bool) string {
	if hasPending {
		return "text-amber-500 font-semibold"
	}
	return "text-sage font-semibold"
}
