package pages

import (
	"strconv"

	"github.com/mccune1224/betrayal/internal/web/templates/layouts"
	"github.com/mccune1224/betrayal/internal/web/templates/partials"
)

// ChannelEntry is one configured (or expected) Discord channel
type ChannelEntry struct {
	Name      string // display name, e.g. "Vote Channel"
	Kind      string // "vote" | "action" | "lifeboard" | "admin" | "confessional"
	ChannelID string // "" when missing
	Status    string // configured | missing | orphaned | unverified
	Note      string
}

// ChannelSummary is the roll-up counts shown at the top of the page
type ChannelSummary struct {
	Total      int
	Configured int
	Missing    int
	Orphaned   int
	Unverified int
}

// ChannelsData is the view model for the /channels page
type ChannelsData struct {
	Entries          []ChannelEntry
	DiscordConnected bool
	Summary          ChannelSummary
}

templ Channels(data ChannelsData) {
	@layouts.Base("Channel Config", "/channels") {
		<h1 class="page-title mb-2">CHANNEL CONFIG</h1>
		<p class="text-dust text-sm mb-6">
			Validation of the channels the bot needs to run. Configure channel IDs here when preparing a game.
		</p>
		<div class="card mb-6">
			<h2 class="font-semibold text-wood mb-3">UPDATE CHANNEL CONFIG</h2>
			<form class="grid grid-cols-1 sm:grid-cols-4 gap-2" hx-post="/channels/update" hx-target="body">
				<select name="kind" class="input"><option value="vote">VOTE</option><option value="action">ACTION</option><option value="lifeboard">LIFEBOARD</option><option value="admin">ADMIN</option><option value="log">COMMAND LOG</option></select>
				<input name="channel_id" class="input" placeholder="Discord channel ID" required/>
				<input name="message_id" class="input" placeholder="Lifeboard message ID (lifeboard only)"/>
				<button class="btn-primary" type="submit">SAVE CHANNEL</button>
			</form>
			<p class="text-xs text-dust mt-2">Use Discord channel IDs. The bot validates the channel when Discord is connected.</p>
		</div>

		if !data.DiscordConnected {
			<div class="bg-parchment-dark border-2 border-rope text-wood px-4 py-3 mb-6 text-base rounded-lg">
				&#9888; Discord is disabled (web-only mode) — configured channels are listed but can't be verified against Discord.
			</div>
		}

		<!-- Summary cards -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
			<div class="card text-center">
				<p class="text-xs text-dust">TOTAL</p>
				<p class="text-2xl font-western text-wood">{ strconv.Itoa(data.Summary.Total) }</p>
			</div>
			<div class="card text-center">
				<p class="text-xs text-dust">OK</p>
				<p class="text-2xl font-western text-sage">{ strconv.Itoa(data.Summary.Configured) }</p>
			</div>
			<div class="card text-center">
				<p class="text-xs text-dust">MISSING</p>
				<p class="text-2xl font-western text-rust">{ strconv.Itoa(data.Summary.Missing) }</p>
			</div>
			<div class="card text-center">
				<p class="text-xs text-dust">ORPHANED</p>
				<p class="text-2xl font-western text-rust">{ strconv.Itoa(data.Summary.Orphaned) }</p>
			</div>
		</div>

		<!-- Mobile card list -->
		<div class="md:hidden space-y-3">
			for _, e := range data.Entries {
				<div class="mobile-card">
					<div class="flex items-center justify-between gap-2 mb-2">
						<span class="font-bold text-wood">{ e.Name }</span>
						@ChannelStatusBadge(e.Status)
					</div>
					if e.ChannelID != "" {
						<p class="text-sm text-dust font-mono break-all">ID: { e.ChannelID }</p>
					}
					if e.Note != "" {
						<p class="text-sm text-dust mt-1">{ e.Note }</p>
					}
				</div>
			}

			if len(data.Entries) == 0 {
				@partials.EmptyState("NO CHANNELS FOUND")
			}
		</div>

		<!-- Desktop table -->
		<div class="hidden md:block card overflow-hidden p-0">
			<div class="overflow-x-auto">
				<table class="w-full min-w-[700px]">
					<thead class="bg-parchment-dark border-b-2 border-leather">
						<tr>
							<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">CHANNEL</th>
							<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">TYPE</th>
							<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">STATUS</th>
							<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">ID</th>
							<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">NOTES</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-rope">
						for _, e := range data.Entries {
							<tr class="hover:bg-parchment-dark/50 transition-colors">
								<td class="px-4 py-4 text-base text-leather font-bold">{ e.Name }</td>
								<td class="px-4 py-4 text-base text-dust uppercase">{ e.Kind }</td>
								<td class="px-4 py-4 text-base">
									@ChannelStatusBadge(e.Status)
								</td>
								<td class="px-4 py-4 text-base text-dust font-mono">{ e.ChannelID }</td>
								<td class="px-4 py-4 text-base text-dust">{ e.Note }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			if len(data.Entries) == 0 {
				@partials.EmptyState("NO CHANNELS FOUND")
			}
		</div>
	}
}

// ChannelStatusBadge renders a colored badge for a channel status
templ ChannelStatusBadge(status string) {
	switch status {
		case "configured":
			<span class="badge-success">OK</span>
		case "missing":
			<span class="badge-danger">MISSING</span>
		case "orphaned":
			<span class="badge-danger">ORPHANED</span>
		case "unverified":
			<span class="badge-neutral">UNVERIFIED</span>
		default:
			<span class="badge-neutral">{ status }</span>
	}
}
