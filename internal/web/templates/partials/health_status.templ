package partials

templ HealthStatus(botStatus string, dbStatus string, lastChecked string) {
	<div class="flex flex-col gap-3">
		<!-- Bot Status -->
		<div class="flex items-center justify-between">
			<span class="text-silver text-base">BOT</span>
			<div class="flex items-center">
				@StatusIndicator(botStatus)
			</div>
		</div>
		
		<!-- Database Status -->
		<div class="flex items-center justify-between">
			<span class="text-silver text-base">DATABASE</span>
			<div class="flex items-center">
				@StatusIndicator(dbStatus)
			</div>
		</div>
		
		<!-- Last Checked -->
		<div class="text-sm text-silver mt-2">
			CHECKED: { lastChecked }
		</div>
		
		<!-- Manual Refresh Button -->
		<button 
			hx-get="/health/status"
			hx-target="#health-status"
			hx-swap="innerHTML"
			class="btn-ghost mt-2">
			REFRESH
		</button>
	</div>
}

templ StatusIndicator(status string) {
	switch status {
		case "online", "ok":
			<span class="status-online"></span>
			<span class="text-jade text-base font-bold">ONLINE</span>
		case "degraded":
			<span class="status-degraded"></span>
			<span class="text-steel text-base font-bold">DEGRADED</span>
		default:
			<span class="status-offline"></span>
			<span class="text-ember text-base font-bold">OFFLINE</span>
	}
}

// Compact version for loading state
templ HealthStatusLoading() {
	<div class="flex items-center justify-center py-4">
		<span class="spinner"></span>
		<span class="ml-2 text-silver text-base">CHECKING...</span>
	</div>
}
