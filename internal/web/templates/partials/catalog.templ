package partials

import (
	"strconv"
)

// CatalogRow is a search result row for the catalog pages (items, abilities,
// statuses) — the generalized roles-search pattern.
type CatalogRow struct {
	ID          int32
	Name        string
	Description string
	Meta        string // e.g. rarity, duration — shown as a small tag
	Path        string // base path for links: "/items", "/abilities", "/statuses"
}

// CatalogSearchResults renders search results as mobile cards + desktop table.
templ CatalogSearchResults(kind string, rows []CatalogRow) {
	<!-- Mobile Card View -->
	<div class="md:hidden p-4 space-y-3">
		for _, r := range rows {
			<a href={ templ.SafeURL(r.Path + "/" + strconv.Itoa(int(r.ID))) } class="mobile-card flex items-center justify-between">
				<div class="flex-1 min-w-0">
					<p class="text-leather truncate text-base font-bold">{ r.Name }</p>
					<p class="text-sm text-dust truncate">{ r.Description }</p>
				</div>
				<span class="text-xs text-dust shrink-0 ml-2">{ r.Meta }</span>
			</a>
		}

		if len(rows) == 0 {
			@EmptyState("NO RESULTS")
		}
	</div>

	<!-- Desktop Table View -->
	<div class="hidden md:block">
		<table class="w-full min-w-[600px]">
			<thead class="bg-parchment-dark border-b-2 border-leather">
				<tr>
					<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">NAME</th>
					<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">DESCRIPTION</th>
					<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold">{ kind }</th>
					<th class="px-4 py-4 text-left text-sm text-wood uppercase font-bold"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-rope">
				for _, r := range rows {
					<tr class="hover:bg-parchment-dark/50 transition-colors">
						<td class="px-4 py-4 text-base text-leather font-bold">{ r.Name }</td>
						<td class="px-4 py-4 text-base text-dust max-w-md truncate">{ r.Description }</td>
						<td class="px-4 py-4 text-base text-wood">{ r.Meta }</td>
						<td class="px-4 py-4 text-base">
							<a href={ templ.SafeURL(r.Path + "/" + strconv.Itoa(int(r.ID))) } class="table-link">
								EDIT &#x2192;
							</a>
						</td>
					</tr>
				}
			</tbody>
		</table>

		if len(rows) == 0 {
			@EmptyState("NO RESULTS")
		}
	</div>
}
