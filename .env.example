DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Production database (selected only when ENVIRONMENT=production).
DATABASE_POOLER_URL=

# Local development database (docker compose / `make db-up`). Tests use this;
# they must NEVER point at DATABASE_POOLER_URL (production).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/betrayal?sslmode=disable
MOCK_DATABASE=postgres://postgres:postgres@localhost:5432/betrayal?sslmode=disable

# Web Admin Panel Configuration
WEB_PORT=8080
ADMIN_PASSWORD=

# Set true to allow destructive panel actions (sync apply, migrations) against the prod DB
WEB_ALLOW_PROD_MUTATIONS=false

# Spreadsheet sync sources (Google Sheets CSV export URLs) — seeded into sync_source at startup
GOOD_ROLES_CSV=
EVIL_ROLES_CSV=
NEUTRAL_ROLES_CSV=
ITEM_CSV=

# Railway API (for redeploy functionality)
RAILWAY_API_TOKEN=
RAILWAY_BETRAYAL_PROJECT_ID=
RAILWAY_BETRAYAL_SERVICE_ID=
RAILWAY_BETRAYAL_ENVIRONMENT_ID=

# Optional: Environment (local, production)
ENVIRONMENT=local
